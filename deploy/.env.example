# think — settings for deploy/compose.yml. Copy to .env and edit.

# The image to run. Pin a version (e.g. :0.6.0) to update only when you choose.
THINK_IMAGE=ghcr.io/olalha/think-board:latest

# The owner of the data folder (run `id -u` and `id -g`). think writes files
# as this user, so you (and agents on this machine) can read and edit them.
PUID=1000
PGID=1000

# The data folder, relative to this file or absolute.
THINK_DATA=./think-data

# The port on 127.0.0.1.
THINK_PORT=8080

# The address you open think at (a proxy's or tunnel's, if you use one): the
# `think` command's links (think new, think url) use it.
THINK_PUBLIC_URL=http://127.0.0.1:8080

# Your time zone (for times shown in the app).
TZ=UTC

# Optional: API-key mode for providers set to "auth": "api-key" (see docs/config.md).
# Leave empty to log in with a subscription from the app instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
