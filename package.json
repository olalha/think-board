{
  "name": "think-board",
  "version": "0.6.3",
  "private": true,
  "description": "A self-hosted canvas for thinking with an AI agent: blocks are files, each canvas has its own agent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olalha/think-board.git"
  },
  "homepage": "https://github.com/olalha/think-board#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/node/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vite build --logLevel error && playwright test",
    "screenshots": "vite build --logLevel error && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.97.0",
    "@agentclientprotocol/codex-acp": "2.3.0",
    "@agentclientprotocol/sdk": "2.0.2",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@resvg/resvg-js": "2.6.2",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.7",
    "image-size": "^2.0.4",
    "jose": "^6.2.12",
    "jsdom": "^30.1.2",
    "mermaid": "12.2.0",
    "node-pty": "^1.1.0",
    "perfect-freehand": "1.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "codemirror-lang-mermaid": "^0.5.0",
    "lucide-react": "^1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "4.1.12",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311"
  }
}
