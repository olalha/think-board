#!/usr/bin/env bash
# Set the password think asks for — for installs without Cloudflare Access or
# another authenticating proxy in front. Prompts without echo; the password
# never appears on a command line or in shell history. Prints only its length.
#
#   app/bin/set-password            # from a checkout: runs it in the think container
#   docker compose exec -it -u think think bin/set-password --local   # installed from the image
#   app/bin/set-password --local    # the server runs directly on this machine
#   app/bin/set-password --off      # remove the password again
set -euo pipefail
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$APP_DIR"

run() {
  if [[ "${1:-}" == "--local" ]]; then
    shift
    if [[ -f dist/node/server/set-password.js ]]; then node dist/node/server/set-password.js "$@"; else node --import tsx src/server/set-password.ts "$@"; fi
  else
    # As the data folder's owner (the image's `think` user), never root.
    docker compose exec -T -u think think node dist/node/server/set-password.js "$@"
  fi
}

mode="${1:-}"
if [[ "$mode" == "--off" || "${2:-}" == "--off" ]]; then
  [[ "$mode" == "--local" ]] && run --local --off || run --off
  exit 0
fi

read -rsp "New think password (10+ characters): " pw; echo
read -rsp "Again: " pw2; echo
[[ "$pw" == "$pw2" ]] || { echo "The two entries differ — nothing changed." >&2; exit 1; }
printf '%s' "$pw" | run ${mode:+"$mode"}
unset pw pw2
